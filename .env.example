# Server-side only. Never put API keys in VITE_* variables.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=82d13948027e4be69892dd3d0104e681
FISH_AUDIO_MODEL=s2.1-pro
# Optional password for this single-user instance. Required behind a public gateway.
JARVIS_ACCESS_TOKEN=
# Use an absolute HTTPS origin when deploying behind a reverse proxy.
JARVIS_PUBLIC_ORIGIN=
JARVIS_DATA_DIR=./data
# Desktop bridge is off until you pair a separately running local agent.
DESKTOP_AGENT_URL=http://127.0.0.1:8765
DESKTOP_AGENT_TOKEN=
